// eSpinSLAM on the synthetic DAVIS346 debris dataset (comparison with the
// proposed method). Paper hyperparameters (Table 1) are kept; only the sensor,
// calibration and admissible period band differ from TOPSPIN.
{
  "data": {
    "sensor_size": [346, 260],
    // Sequences are truncated to 5 s for the event_snn_torch comparison. Loop
    // closure needs roughly two revolutions, so periods above ~2.5 s abstain.
    "max_duration_seconds": 5.0,
    "time_unit": "auto",
    "evaluation_split": "test"
  },
  "camera": {
    "fx": 528.6111111111,
    "fy": 528.6111111111,
    "cx": 173.0,
    "cy": 130.0
  },
  "frontend": {
    "interpretation_mode": "experimental",
    "chunk_events": 1000,
    "density_radius_px": 3.0,
    "density_mean_per_polarity": false,
    "cluster_min_size": 5,
    "cluster_min_samples": 3,
    "cluster_selection_epsilon": 0.0,
    "cluster_time_scale_px_per_second": 1000.0,
    "cluster_by_polarity": true,
    "association_radius_px": 5.0,
    "association_max_gap_seconds": 0.05,
    "association_head_events": 5,
    "retain_events_per_track": 1000          // sigma_retain
  },
  "frequency": {
    "method": "loop_closure",
    "alignment_mode": "experimental",
    "update_interval_seconds": 0.1,
    "min_period_seconds": 1.0,
    "max_period_seconds": 10.0,
    "time_scale_px_per_second": 200.0,
    "harmonic_tolerance": 0.15,
    "loop_std_threshold_hz": 0.001,          // sigma
    "loop_history": 20                       // aleph
  },
  "backend": {
    "interpretation_mode": "experimental",
    "solver_backend": "equivalent_custom",
    "orbit_radius": 10.0,                    // r
    "min_track_events": 3,                   // N_match
    "huber_threshold_px": 2.0,               // inlier threshold of rho
    "max_mean_reprojection_error_px": 10.0,  // gamma
    "landmark_merge_radius": 0.01,           // delta_fuse
    "optimization_cadence_revolutions": 0.1, // epsilon
    "forget_revolutions": 3.0,               // sigma_forget
    "max_iterations": 100,
    "min_triangulation_angle_deg": 1.5,
    "max_observations_per_track": 0,
    "optimize_frequency": false,
    "landmark_association": true,
    "final_offline_refinement": true
  },
  "evaluation": {
    "observation_times_seconds": [0.25, 0.5, 0.75, 1.0, 1.5, 2.0, 3.0, 4.0, 5.0],
    "pointcloud_max_reference_points": 30000,
    "failure_policy": "report_and_mark_invalid"
  },
  "logging": {
    "wandb": false,
    "wandb_mode": "online",
    "wandb_project": "snn-research",
    "wandb_entity": "2075905828-the-university-of-tokyo",
    "wandb_run_name": "espinslam-debris",
    "wandb_tags": ["espinslam", "paper-faithful-reproduction", "held-out-test"]
  }
}
